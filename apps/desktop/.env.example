# Copy to .env.local and fill in. .env.local is git-ignored.
# Google OAuth client of type "Desktop app" (Google Cloud Console → Clients). For desktop
# clients Google does not treat the secret as confidential; it ends up in the binary.
# Read at build time by src-tauri/build.rs; never exposed to the frontend bundle.
ANKYLOCK_GOOGLE_CLIENT_ID=
ANKYLOCK_GOOGLE_CLIENT_SECRET=
# Optional blind relay for instant sync (run locally: GOOGLE_CLIENT_ID=<id> cargo run --manifest-path apps/relay/Cargo.toml).
# Leave it unset (or commented out) to sync through Google Drive only.
VITE_RELAY_URL=ws://127.0.0.1:8787/ws
