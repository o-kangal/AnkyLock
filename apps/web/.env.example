# Copy to .env.local and fill in. .env.local is git-ignored.
# Google OAuth client of type "Web application" (Google Cloud Console → Clients), with
#   Authorized JavaScript origin: http://localhost:5173
#   Authorized redirect URI:      http://localhost:5173/oauth-callback.html
# The client id is public (it appears in the sign-in URL); the web flow uses no client secret.
# Without it the web app runs local-only.
VITE_GOOGLE_CLIENT_ID=
# Blind relay WebSocket endpoint; its origin is also allowed in the production CSP.
VITE_RELAY_URL=ws://127.0.0.1:8787/ws
